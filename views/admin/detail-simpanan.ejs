<%
  currentPath = '/admin/simpanan';
  isAdmin = true;
  function formatRp(val) {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(val);
  }
%>

<div class="page-header animate-in">
  <div class="page-header-title">
    <h1><i class="bi bi-book"></i> Buku Simpanan Anggota</h1>
    <p>Riwayat mutasi setoran dan penarikan simpanan anggota koperasi</p>
  </div>
  <div class="page-header-actions d-flex gap-2">
    <button type="button" class="btn-primary" onclick="openModalTransaksi()">
      <i class="bi bi-plus-lg"></i> Tambah Transaksi
    </button>
    <a href="/admin/simpanan" class="btn-secondary">
      <i class="bi bi-arrow-left"></i> Kembali
    </a>
  </div>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success animate-in">
    <i class="bi bi-check-circle-fill"></i> <%= success %>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger animate-in">
    <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
  </div>
<% } %>

<!-- Profil Singkat Anggota & 4 Saldo Simpanan -->
<div class="card mb-4 animate-in">
  <div class="card-body">
    <div class="d-flex justify-between align-center flex-wrap gap-3">
      <div class="d-flex align-center gap-3">
        <div class="avatar-lg"><%= anggota.nama.charAt(0).toUpperCase() %></div>
        <div>
          <h2 style="font-size:20px;margin-bottom:4px;"><%= anggota.nama %></h2>
          <div class="text-secondary" style="font-size:13px;">
            <span>NIP: <code><%= anggota.nip %></code></span> &bull; 
            <span>Jabatan: <strong><%= anggota.jabatan || 'Pegawai' %></strong></span> &bull; 
            <span>Unit Kerja: <strong><%= anggota.unit_kerja || 'Kanreg V BKN' %></strong></span>
          </div>
          <% if (anggota.no_hp) { %>
            <div class="text-muted" style="font-size:12px;margin-top:2px;">No. HP: <%= anggota.no_hp %></div>
          <% } %>
        </div>
      </div>
      <div class="text-right">
        <div class="text-muted" style="font-size:12px;">Total Saldo Simpanan</div>
        <div style="font-size:26px;font-weight:800;color:#c4b5fd;"><%= formatRp(saldo.total) %></div>
      </div>
    </div>
  </div>
</div>

<!-- 4 Saldo Box -->
<div class="stats-grid mb-4 animate-in">
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-label">a. Simpanan Pokok</div>
      <div class="stat-value" style="color:#60a5fa;"><%= formatRp(saldo.pokok) %></div>
      <div class="stat-desc mt-1">
        <% if (isPokokLunas) { %>
          <span class="badge badge-success" style="font-size:11px; padding:2px 7px;">
            <i class="bi bi-check-circle-fill"></i> LUNAS (Rp 1.005.000)
          </span>
        <% } else { %>
          <span class="badge badge-warning" style="font-size:11px; padding:2px 7px;">
            <i class="bi bi-hourglass-split"></i> Kurang <%= formatRp(sisaPokok) %>
          </span>
        <% } %>
      </div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-label">b. Simpanan Wajib</div>
      <div class="stat-value" style="color:#34d399;"><%= formatRp(saldo.wajib) %></div>
      <div class="stat-desc mt-1">Iuran rutin <%= formatRp(simpananWajibPerBulan) %>/bln</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-label">c. Simpanan Sukarela</div>
      <div class="stat-value" style="color:#fbbf24;"><%= formatRp(saldo.sukarela) %></div>
      <div class="stat-desc mt-1">Tabungan fleksibel (setor/tarik)</div>
    </div>
  </div>
  <div class="stat-card stat-highlight">
    <div class="stat-info">
      <div class="stat-label">d. Total Keseluruhan</div>
      <div class="stat-value" style="color:#a78bfa;"><%= formatRp(saldo.total) %></div>
      <div class="stat-desc mt-1">Total aset simpanan anggota</div>
    </div>
  </div>
</div>

<!-- Progress Card Status Pemenuhan Simpanan Pokok -->
<div class="card mb-4 animate-in" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(59, 130, 246, 0.25);">
  <div class="card-body p-3">
    <div class="d-flex justify-between align-center mb-2">
      <div class="d-flex align-center gap-2">
        <i class="bi bi-shield-check text-primary" style="font-size: 1.25rem;"></i>
        <div>
          <strong style="color: #f1f5f9; font-size: 0.95rem;">Status Simpanan Pokok Pegawai (Kewajiban 1x di Awal: Rp 1.005.000)</strong>
          <div class="text-muted" style="font-size: 0.8rem;">
            Skema: <strong><%= anggota.skema_simpanan_pokok === 'cicil' ? `Dicicil ${anggota.tenor_simpanan_pokok || 12} Bulan (@ ${formatRp(cicilanPerBulan)}/bln)` : 'Bayar Lunas Sekaligus' %></strong>
          </div>
        </div>
      </div>
      <div class="text-right">
        <% if (isPokokLunas) { %>
          <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Sudah Terpenuhi 100%</span>
        <% } else { %>
          <span class="badge badge-warning"><i class="bi bi-hourglass-split"></i> Progres <%= persenPokok %>% (<%= formatRp(saldo.pokok) %> / Rp 1.005.000)</span>
        <% } %>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="progress-bar-wrap" style="height: 10px; background: rgba(255,255,255,0.08); border-radius: 999px; overflow: hidden;">
      <div class="progress-bar-fill" style="width: <%= persenPokok %>%; height: 100%; background: <%= isPokokLunas ? '#10b981' : '#3b82f6' %>; border-radius: 999px; transition: width 0.4s ease;"></div>
    </div>

    <div class="d-flex justify-between align-center mt-2" style="font-size: 0.8rem;">
      <span class="text-muted">Terbayar: <strong style="color: #60a5fa;"><%= formatRp(saldo.pokok) %></strong></span>
      <% if (!isPokokLunas) { %>
        <span class="text-warning">Sisa Tagihan Pokok: <strong><%= formatRp(sisaPokok) %></strong> (Dapat dicicil maks 12 bulan)</span>
      <% } else { %>
        <span class="text-success"><i class="bi bi-check-all"></i> Simpanan pokok telah lunas. Anggota tidak memiliki kewajiban pokok lagi.</span>
      <% } %>
    </div>
  </div>
</div>

<!-- Tabel Riwayat Mutasi Simpanan -->
<div class="card animate-in">
  <div class="card-header d-flex justify-between align-center">
    <h3><i class="bi bi-clock-history"></i> Riwayat Mutasi Simpanan (<%= riwayat.length %>)</h3>
    <button type="button" class="btn-primary-sm" onclick="openModalTransaksi()">
      <i class="bi bi-plus-circle"></i> Input Mutasi
    </button>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th width="40">No</th>
            <th>Tanggal</th>
            <th>Jenis Simpanan</th>
            <th>Tipe Transaksi</th>
            <th>Keterangan</th>
            <th class="text-right">Nominal (Rp)</th>
            <th>Petugas</th>
            <th width="80" class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (riwayat.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">Belum ada riwayat transaksi simpanan untuk anggota ini.</td>
            </tr>
          <% } else { %>
            <% riwayat.forEach((r, idx) => { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= new Date(r.tanggal).toLocaleDateString('id-ID', { dateStyle: 'medium' }) %></td>
                <td>
                  <% if (r.jenis_simpanan === 'pokok') { %>
                    <span class="badge badge-info">Simpanan Pokok</span>
                  <% } else if (r.jenis_simpanan === 'wajib') { %>
                    <span class="badge badge-success">Simpanan Wajib</span>
                  <% } else { %>
                    <span class="badge badge-warning">Simpanan Sukarela</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.tipe_transaksi === 'setor') { %>
                    <span style="color:#34d399;font-weight:600;"><i class="bi bi-arrow-down-left-circle"></i> Setor (+)</span>
                  <% } else { %>
                    <span style="color:#f87171;font-weight:600;"><i class="bi bi-arrow-up-right-circle"></i> Tarik (-)</span>
                  <% } %>
                </td>
                <td><%= r.keterangan || '-' %></td>
                <td class="text-right font-mono font-bold" style="<%= r.tipe_transaksi === 'setor' ? 'color:#34d399;' : 'color:#f87171;' %>">
                  <%= r.tipe_transaksi === 'setor' ? '+' : '-' %> <%= formatRp(r.nominal) %>
                </td>
                <td><small class="text-muted"><%= r.admin_nama || 'Admin' %></small></td>
                <td class="text-center">
                  <div class="d-flex justify-center gap-1">
                    <a href="/admin/simpanan/transaksi/<%= r.id %>/kwitansi" target="_blank" class="btn-sm btn-outline-primary" title="Cetak Kwitansi">
                      <i class="bi bi-printer"></i>
                    </a>
                    <form action="/admin/simpanan/transaksi/hapus/<%= r.id %>?user_id=<%= anggota.id %>" method="POST" onsubmit="return confirm('Hapus transaksi ini?');">
                      <button type="submit" class="btn-sm btn-outline-danger" title="Hapus Mutasi">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Input Transaksi Simpanan untuk Anggota ini -->
<div id="modalTransaksi" class="modal-backdrop" style="display:none;">
  <div class="modal-dialog animate-in" style="max-width: 500px;">
    <div class="modal-content card">
      <div class="card-header d-flex justify-between align-center">
        <h3><i class="bi bi-cash-coin"></i> Transaksi Simpanan: <%= anggota.nama %></h3>
        <button type="button" class="btn-close" onclick="closeModalTransaksi()">&times;</button>
      </div>
      <div class="card-body">
        <form action="/admin/simpanan/transaksi" method="POST">
          <input type="hidden" name="user_id" value="<%= anggota.id %>" />
          <input type="hidden" name="redirect_to" value="/admin/simpanan/anggota/<%= anggota.id %>" />

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label">Jenis Simpanan <span class="required">*</span></label>
              <select name="jenis_simpanan" id="mJenis" class="form-control" required>
                <% if (isPokokLunas) { %>
                  <option value="pokok" disabled>a. Simpanan Pokok (Sudah Lunas - Maks Rp 1.005.000)</option>
                  <option value="wajib" selected>b. Simpanan Wajib</option>
                  <option value="sukarela">c. Simpanan Sukarela</option>
                <% } else { %>
                  <option value="pokok">a. Simpanan Pokok (Sisa: <%= formatRp(sisaPokok) %>)</option>
                  <option value="wajib" selected>b. Simpanan Wajib</option>
                  <option value="sukarela">c. Simpanan Sukarela</option>
                <% } %>
              </select>
              <% if (isPokokLunas) { %>
                <small style="color: #34d399; font-size: 11px; margin-top: 4px; display: block;">
                  <i class="bi bi-check-circle-fill"></i> Simpanan Pokok sudah lunas (Rp 1.005.000).
                </small>
              <% } %>
            </div>

            <div class="form-group">
              <label class="form-label">Tipe Transaksi <span class="required">*</span></label>
              <select name="tipe_transaksi" id="mTipe" class="form-control" required>
                <option value="setor">🟢 Setoran (+)</option>
                <option value="tarik">🔴 Penarikan (-)</option>
              </select>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label">Nominal (Rp) <span class="required">*</span></label>
              <input type="text" inputmode="numeric" name="nominal" id="mNominal" class="form-control input-rupiah" value="100.000" placeholder="Contoh: 100.000" required />
            </div>

            <div class="form-group">
              <label class="form-label">Tanggal <span class="required">*</span></label>
              <input type="date" name="tanggal" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Keterangan</label>
            <input type="text" name="keterangan" id="mKet" class="form-control" value="Setoran Simpanan Wajib" />
          </div>

          <div class="d-flex justify-end gap-2 mt-4 pt-3 border-top">
            <button type="button" class="btn-secondary" onclick="closeModalTransaksi()">Batal</button>
            <button type="submit" class="btn-primary"><i class="bi bi-save"></i> Simpan Transaksi</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function openModalTransaksi() { document.getElementById('modalTransaksi').style.display = 'flex'; }
function closeModalTransaksi() { document.getElementById('modalTransaksi').style.display = 'none'; }

document.getElementById('mJenis').addEventListener('change', () => updateKet(true));
document.getElementById('mTipe').addEventListener('change', () => updateKet(true));

function updateKet(updateNominal = true) {
  const j = document.getElementById('mJenis').value;
  const t = document.getElementById('mTipe').value;
  const lt = t === 'setor' ? 'Setoran' : 'Penarikan';
  const lj = j === 'pokok' ? 'Simpanan Pokok' : (j === 'wajib' ? 'Simpanan Wajib' : 'Simpanan Sukarela');
  
  if (updateNominal) {
    const nomEl = document.getElementById('mNominal');
    if (j === 'wajib' && t === 'setor') {
      nomEl.value = '100.000';
      nomEl.dispatchEvent(new Event('input'));
    } else if (j === 'pokok' && t === 'setor') {
      const sisa = <%= sisaPokok %>;
      const cicilan = <%= cicilanPerBulan %>;
      nomEl.value = sisa > 0 ? (cicilan > 0 ? cicilan.toLocaleString('id-ID') : sisa.toLocaleString('id-ID')) : '1.005.000';
      nomEl.dispatchEvent(new Event('input'));
    }
  }
  document.getElementById('mKet').value = `${lt} ${lj}`;
}
</script>
