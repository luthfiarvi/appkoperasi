<%
  currentPath = '/admin/pensiun';
  isAdmin = true;
%>

<div class="page-header animate-in">
  <div class="page-header-title">
    <h1><i class="bi bi-box-arrow-right"></i> Konfirmasi Penarikan Dana Pensiun</h1>
    <p>Verifikasi perhitungan hak simpanan anggota dan penyelesaian kewajiban pinjaman sebelum pencairan dana</p>
  </div>
  <div class="page-header-actions">
    <a href="/admin/pensiun" class="btn-secondary">
      <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
  </div>
</div>

<% if (locals.error) { %>
  <div class="alert alert-danger animate-in">
    <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
  </div>
<% } %>

<div class="card animate-in" style="max-width: 900px; margin: 0 auto;">
  <div class="card-header d-flex justify-between align-center">
    <h3><i class="bi bi-person-badge"></i> Data Identitas Pegawai ASN</h3>
    <span class="badge <%= anggota.status_keanggotaan === 'PENSIUN' ? 'badge-yellow' : 'badge-green' %>">
      <%= anggota.status_keanggotaan || 'AKTIF' %>
    </span>
  </div>
  <div class="card-body p-4">
    <!-- Profil Anggota -->
    <div class="d-flex align-center gap-3 mb-4 p-3 rounded" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border);">
      <div class="avatar-lg"><%= anggota.nama.charAt(0).toUpperCase() %></div>
      <div class="flex-1">
        <h3 style="font-size: 1.15rem; margin-bottom: 2px;"><%= anggota.nama %></h3>
        <div class="text-secondary" style="font-size: 13px;">
          <span>NIP: <code><%= anggota.nip %></code></span> &bull; 
          <span>Jabatan: <strong><%= anggota.jabatan || 'Pegawai' %></strong></span> &bull; 
          <span>Unit Kerja: <strong><%= anggota.unit_kerja || 'Kanreg V BKN' %></strong></span>
        </div>
        <% if (anggota.no_hp) { %>
          <div class="text-muted" style="font-size: 12px; margin-top: 2px;">
            <i class="bi bi-telephone"></i> <%= anggota.no_hp %> | <i class="bi bi-envelope"></i> <%= anggota.email %>
          </div>
        <% } %>
      </div>
    </div>

    <form action="/admin/pensiun/proses" method="POST" id="formPensiun" onsubmit="return konfirmasiPensiun()">
      <input type="hidden" name="user_id" value="<%= anggota.id %>" />

      <!-- Rincian Hak Simpanan Anggota -->
      <h4 class="mb-3" style="font-size: 15px; color: #93c5fd; font-weight: 600;">
        <i class="bi bi-wallet2 text-primary me-2"></i> 1. Rincian Saldo Hak Simpanan Anggota
      </h4>
      <div class="table-responsive mb-4">
        <table class="table">
          <thead>
            <tr>
              <th>Jenis Simpanan</th>
              <th>Keterangan Kebijakan</th>
              <th class="text-right">Nominal Saldo</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong style="color: #60a5fa;"><i class="bi bi-bank me-1"></i> Simpanan Pokok</strong></td>
              <td class="text-muted" style="font-size: 12px;">Hak simpanan awal keanggotaan (Target Rp 1.005.000)</td>
              <td class="text-right font-mono" style="color: #60a5fa; font-weight: 600;"><%= formatRp(saldo.pokok) %></td>
            </tr>
            <tr>
              <td><strong style="color: #34d399;"><i class="bi bi-calendar-check me-1"></i> Simpanan Wajib</strong></td>
              <td class="text-muted" style="font-size: 12px;">Akumulasi iuran rutin payroll Rp 100.000/bln selama aktif</td>
              <td class="text-right font-mono" style="color: #34d399; font-weight: 600;"><%= formatRp(saldo.wajib) %></td>
            </tr>
            <tr>
              <td><strong style="color: #fbbf24;"><i class="bi bi-piggy-bank me-1"></i> Simpanan Sukarela</strong></td>
              <td class="text-muted" style="font-size: 12px;">Tabungan sukarela yang belum ditarik anggota</td>
              <td class="text-right font-mono" style="color: #fbbf24; font-weight: 600;"><%= formatRp(saldo.sukarela) %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="background: rgba(59, 130, 246, 0.08);">
              <td colspan="2"><strong>SUBTOTAL SELURUH HAK SIMPANAN (KOTOR)</strong></td>
              <td class="text-right font-mono font-bold" style="font-size: 16px; color: #93c5fd;">
                <%= formatRp(saldo.total) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Pengecekan Tanggungan Pinjaman -->
      <h4 class="mb-3" style="font-size: 15px; color: #f87171; font-weight: 600;">
        <i class="bi bi-cash-coin me-2"></i> 2. Pemeriksaan Tanggungan Pinjaman Berjalan
      </h4>

      <% if (pinjamanAktif && sisaHutang > 0) { %>
        <div class="p-3 mb-4 rounded" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.3);">
          <div class="d-flex justify-between align-center mb-2 flex-wrap gap-2">
            <div>
              <strong class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Anggota Masih Memiliki Pinjaman Aktif</strong>
              <div class="text-muted" style="font-size: 12px; margin-top: 2px;">
                Plafon Pinjaman: <%= formatRp(pinjamanAktif.nominal_pengajuan) %> | Tenor <%= pinjamanAktif.tenor_bulan %> Bulan | Sisa Cicilan: <%= pinjamanAktif.sisa_cicilan_bulan %> Bulan
              </div>
            </div>
            <div class="text-right">
              <span class="badge badge-red font-mono font-bold" style="font-size: 13px;">
                Sisa Pokok: <%= formatRp(sisaHutang) %>
              </span>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top" style="border-color: rgba(239, 68, 68, 0.2) !important;">
            <label class="d-flex align-center gap-2 cursor-pointer">
              <input type="checkbox" name="potong_pinjaman" id="checkPotongPinjaman" value="1" checked onchange="hitungNetto()" />
              <span style="font-weight: 600; font-size: 13.5px; color: #fecaca;">
                Potong sisa hutang pinjaman (<%= formatRp(sisaHutang) %>) langsung dari total simpanan pensiun & lunaskan pinjaman
              </span>
            </label>
            <small class="form-hint" style="color: #fca5a5; display: block; margin-top: 4px;">
              Pinjaman otomatis berstatus LUNAS dan cicilan tidak akan lagi ditagihkan ke payroll gaji berikutnya.
            </small>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-success mb-4">
          <i class="bi bi-check-circle-fill"></i> <strong>Bebas Tanggungan:</strong> Anggota tidak memiliki pinjaman aktif yang berjalan di Koperasi BKN Kanreg V. Seluruh hak simpanan dapat dicairkan 100%.
          <input type="hidden" name="potong_pinjaman" id="checkPotongPinjaman" value="0" />
        </div>
      <% } %>

      <!-- Ringkasan Total Dana Bersih Diterima -->
      <div class="p-4 mb-4 rounded text-center" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 95, 70, 0.2)); border: 2px solid rgba(16, 185, 129, 0.4);">
        <div class="text-muted text-uppercase" style="font-size: 12px; letter-spacing: 1px; font-weight: 600;">
          Total Bersih Dana Pensiun yang Diterima Anggota (Netto)
        </div>
        <div class="font-mono font-bold my-2" id="labelTotalBersih" style="font-size: 32px; color: #34d399;">
          <%= formatRp(estimasiNetto) %>
        </div>
        <div class="text-muted" style="font-size: 13px;" id="labelKeteranganPotongan">
          <% if (pinjamanAktif && sisaHutang > 0) { %>
            (Total Simpanan <%= formatRp(saldo.total) %> &minus; Pelunasan Hutang <%= formatRp(sisaHutang) %>)
          <% } else { %>
            (Pencairan penuh tanpa potongan pinjaman)
          <% } %>
        </div>
      </div>

      <!-- Alasan & Keterangan -->
      <div class="form-grid-2 mb-3">
        <div class="form-group">
          <label class="form-label">Alasan Penarikan / Berhenti Anggota <span class="required">*</span></label>
          <div class="input-wrapper">
            <i class="bi bi-card-checklist input-icon"></i>
            <select name="alasan" class="form-control" required>
              <option value="Pensiun (Batas Usia Pensiun)" selected>Pensiun (Batas Usia Pensiun ASN)</option>
              <option value="Pensiun Dini / Atas Permintaan Sendiri">Pensiun Dini / Atas Permintaan Sendiri (APS)</option>
              <option value="Mutasi / Pindah Instansi Luar BKN">Mutasi / Pindah Instansi ke Luar Kanreg V BKN</option>
              <option value="Mengundurkan Diri dari Keanggotaan">Mengundurkan Diri dari Keanggotaan Koperasi</option>
              <option value="Meninggal Dunia (Diterima Ahli Waris)">Meninggal Dunia (Diserahkan ke Ahli Waris)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Catatan Tambahan / No. Rekening Pencairan</label>
          <div class="input-wrapper">
            <i class="bi bi-pencil-square input-icon"></i>
            <input type="text" name="keterangan" class="form-control" placeholder="Contoh: Ditransfer ke Bank BNI Rek: 123456789 a.n Budi Santoso" />
          </div>
        </div>
      </div>

      <!-- Peringatan Sistem -->
      <div class="alert alert-warning mb-4" style="font-size: 12.5px;">
        <i class="bi bi-exclamation-octagon-fill"></i> <strong>Perhatian:</strong> Setelah proses pencairan ini dikonfirmasi:
        <ul style="margin: 6px 0 0 20px; line-height: 1.6;">
          <li>Saldo simpanan pokok, wajib, dan sukarela anggota akan otomatis dicatat <strong>Tarik (Saldo Rp 0)</strong>.</li>
          <li>Status anggota otomatis diubah menjadi <strong>PENSIUN</strong> dan tidak akan ditagih lagi pada payroll gaji berikutnya.</li>
          <li>Sistem akan langsung menerbitkan <strong>Surat Berita Acara & Bukti Pencairan Resmi</strong> yang dapat dicetak/disimpan sebagai PDF.</li>
        </ul>
      </div>

      <!-- Action Buttons -->
      <div class="d-flex justify-between align-center pt-3 border-top">
        <a href="/admin/pensiun" class="btn-secondary">
          <i class="bi bi-x-circle"></i> Batal
        </a>
        <button type="submit" class="btn-success" id="btnKonfirmasi" style="padding: 12px 24px; font-size: 15px; font-weight: 700;">
          <i class="bi bi-check2-circle"></i> Konfirmasi & Cairkan Semua Dana Pensiun
        </button>
      </div>

    </form>
  </div>
</div>

<script>
const TOTAL_SIMPANAN = <%= saldo.total %>;
const SISA_HUTANG = <%= sisaHutang %>;

function formatRupiah(num) {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0
  }).format(num);
}

function hitungNetto() {
  const chk = document.getElementById('checkPotongPinjaman');
  const isChecked = chk ? chk.checked : false;
  
  let netto = TOTAL_SIMPANAN;
  const labelNetto = document.getElementById('labelTotalBersih');
  const labelKet = document.getElementById('labelKeteranganPotongan');

  if (isChecked && SISA_HUTANG > 0) {
    netto = Math.max(0, TOTAL_SIMPANAN - SISA_HUTANG);
    labelNetto.textContent = formatRupiah(netto);
    labelKet.textContent = `(Total Simpanan ${formatRupiah(TOTAL_SIMPANAN)} − Pelunasan Hutang ${formatRupiah(SISA_HUTANG)})`;
  } else {
    netto = TOTAL_SIMPANAN;
    labelNetto.textContent = formatRupiah(netto);
    labelKet.textContent = `(Pencairan simpanan penuh tanpa pemotongan hutang)`;
  }
}

function konfirmasiPensiun() {
  const nettoStr = document.getElementById('labelTotalBersih').textContent;
  return confirm(`YAKIN INGIN MEMPROSES PENCAIRAN PENSIUN?\n\nAnggota: <%= anggota.nama %> (NIP: <%= anggota.nip %>)\nTotal Dana Bersih: ${nettoStr}\n\nSetelah dikonfirmasi, saldo simpanan akan dinolkan dan akun akan berstatus PENSIUN. Lanjutkan?`);
}
</script>
