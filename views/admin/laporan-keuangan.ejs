<%
  currentPath = '/admin/laporan';
  isAdmin = true;

  const _simpanan = locals.simpanan || {};
  const _pinjaman = locals.pinjaman || {};
  const _kas      = locals.kas || {};

  const _kasSaldo = _kas.saldo !== undefined ? _kas.saldo : 0;
  const _piutang  = _pinjaman.sisaPiutang !== undefined ? _pinjaman.sisaPiutang : 0;
  const _laba     = _pinjaman.labaOperasional !== undefined ? _pinjaman.labaOperasional : 0;
  const _premi    = _pinjaman.totalPremi !== undefined ? _pinjaman.totalPremi : (_pinjaman.totalAdmin || 0);
  const _bunga    = _pinjaman.bungaPendapatan !== undefined ? _pinjaman.bungaPendapatan : 0;

  var neraca = locals.neraca || {
    aktiva: {
      kas: _kasSaldo,
      piutang: _piutang,
      total: _kasSaldo + _piutang
    },
    pasiva: {
      kewajiban: {
        simpananSukarela: _simpanan.sukarela || 0,
        total: _simpanan.sukarela || 0
      },
      ekuitas: {
        simpananPokok: _simpanan.pokok || 0,
        simpananWajib: _simpanan.wajib || 0,
        shuBerjalan: _laba,
        total: (_simpanan.pokok || 0) + (_simpanan.wajib || 0) + _laba
      },
      total: (_simpanan.sukarela || 0) + (_simpanan.pokok || 0) + (_simpanan.wajib || 0) + _laba
    },
    isBalance: true
  };

  var rugiLaba = locals.rugiLaba || {
    pendapatanBunga: _bunga,
    pendapatanPremi: _premi,
    totalPendapatan: _bunga + _premi,
    bebanOperasional: 0,
    shuBersih: _bunga + _premi
  };

  var arusKas = locals.arusKas || {
    masuk: {
      simpanan: _simpanan.totalSetor || _simpanan.total || 0,
      pokokAngsuran: _pinjaman.pokokTerbayar || 0,
      bunga: _bunga,
      premi: _premi,
      total: _kas.masuk || 0
    },
    keluar: {
      pencairanPinjaman: _pinjaman.totalPlafon || 0,
      penarikanSukarela: _simpanan.totalTarik || 0,
      total: _kas.keluar || 0
    },
    saldoKas: _kasSaldo
  };
%>

<style>
  /* ── Penyesuaian Responsif & Anti-Terpotong ── */
  .stats-grid-fluid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-card-clean {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .stat-card-clean .stat-info {
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }
  .stat-card-clean .stat-value {
    font-size: 19px;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .stat-card-clean .stat-label {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
  }
  .stat-card-clean .stat-desc {
    font-size: 11px;
    color: var(--text-muted);
    word-break: break-word;
    line-height: 1.3;
  }

  .neraca-dual-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
  }
  .neraca-side {
    padding: 18px 20px;
    min-width: 0;
  }
  .neraca-side-left {
    border-right: 1px solid var(--border);
  }
  .financial-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
    width: 100%;
  }
  
  @media (max-width: 1024px) {
    .neraca-dual-layout {
      grid-template-columns: 1fr;
    }
    .neraca-side-left {
      border-right: none;
      border-bottom: 2px solid var(--border);
    }
    .financial-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .table-clean {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 0;
  }
  .table-clean th {
    padding: 10px 14px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
    border-bottom: 1px solid var(--border);
  }
  .table-clean td {
    padding: 11px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    vertical-align: middle;
    word-break: break-word;
  }
  .table-clean tfoot td {
    padding: 12px 14px;
    font-weight: 800;
  }
  .num-col {
    white-space: nowrap;
    text-align: right;
    font-family: monospace;
    font-size: 13px;
  }
</style>

<div class="page-header animate-in">
  <div class="page-header-title">
    <h1><i class="bi bi-bank2"></i> Laporan Keuangan, Neraca & Laba Rugi</h1>
    <p>Sistem Akuntansi Terpadu: Neraca Berimbang, Perhitungan Hasil Usaha (Laba Rugi), Arus Kas & Premi Pinjaman</p>
  </div>
  <div class="page-header-actions d-flex gap-2 flex-wrap">
    <a href="/admin/laporan/export-excel" class="btn-success">
      <i class="bi bi-file-earmark-excel-fill"></i> Ekspor Excel (.xlsx)
    </a>
    <a href="/admin/laporan/print" target="_blank" class="btn-primary">
      <i class="bi bi-printer-fill"></i> Cetak Laporan Resmi (PDF)
    </a>
  </div>
</div>

<!-- 4 Kotak Sorotan Keuangan Utama (Fluid & Anti-Cut) -->
<div class="stats-grid-fluid animate-in">
  <div class="stat-card-clean">
    <div class="stat-icon" style="background: rgba(59,130,246,0.15); color: #60a5fa; width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0;">
      <i class="bi bi-calculator"></i>
    </div>
    <div class="stat-info">
      <div class="stat-label">Total Aktiva (Aset Koperasi)</div>
      <div class="stat-value" style="color: #60a5fa;"><%= formatRp(neraca.aktiva.total) %></div>
      <div class="stat-desc">Kas (<%= formatRp(neraca.aktiva.kas) %>) + Piutang</div>
    </div>
  </div>

  <div class="stat-card-clean">
    <div class="stat-icon" style="background: rgba(16,185,129,0.15); color: #34d399; width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0;">
      <i class="bi bi-check-circle-fill"></i>
    </div>
    <div class="stat-info">
      <div class="stat-label">Total Pasiva (Modal & Hutang)</div>
      <div class="stat-value" style="color: #34d399;"><%= formatRp(neraca.pasiva.total) %></div>
      <div class="stat-desc">
        <span class="badge badge-success" style="font-size:10px; padding: 2px 8px;">
          <i class="bi bi-check2-circle"></i> <%= neraca.isBalance ? 'SEIMBANG / BALANCE' : 'REKONSILIASI' %>
        </span>
      </div>
    </div>
  </div>

  <div class="stat-card-clean">
    <div class="stat-icon" style="background: rgba(245,158,11,0.15); color: #fbbf24; width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0;">
      <i class="bi bi-cash-stack"></i>
    </div>
    <div class="stat-info">
      <div class="stat-label">Saldo Kas & Bank Tersedia</div>
      <div class="stat-value" style="color: #fbbf24;"><%= formatRp(arusKas.saldoKas) %></div>
      <div class="stat-desc">Likuiditas kas berjalan koperasi</div>
    </div>
  </div>

  <div class="stat-card-clean">
    <div class="stat-icon" style="background: rgba(139,92,246,0.15); color: #a78bfa; width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0;">
      <i class="bi bi-graph-up-arrow"></i>
    </div>
    <div class="stat-info">
      <div class="stat-label">Sisa Hasil Usaha (SHU Berjalan)</div>
      <div class="stat-value" style="color: #a78bfa;"><%= formatRp(rugiLaba.shuBersih) %></div>
      <div class="stat-desc">Laba Bunga + Premi Pinjaman (1%)</div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 1. LAPORAN NERACA KEUANGAN (BALANCE SHEET) -->
<!-- ========================================== -->
<div class="card mb-4 animate-in" style="border: 1.5px solid rgba(59,130,246,0.35);">
  <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
    <h3><i class="bi bi-scale"></i> 1. Neraca Keuangan Koperasi (Balance Sheet)</h3>
    <span class="badge badge-info" style="font-size:11px; padding: 4px 10px;">
      <i class="bi bi-check2-all"></i> Aktiva = Pasiva (<%= neraca.isBalance ? 'Seimbang 100%' : 'Perlu Rekonsiliasi' %>)
    </span>
  </div>
  <div class="card-body p-0">
    <div class="neraca-dual-layout">
      
      <!-- SISI KIRI: AKTIVA -->
      <div class="neraca-side neraca-side-left">
        <div style="font-size: 13px; font-weight: 700; color: #60a5fa; text-transform: uppercase; margin-bottom: 12px; display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
          <span>AKTIVA (ASET KOPERASI)</span>
          <span>JUMLAH (RP)</span>
        </div>
        <div class="table-responsive">
          <table class="table-clean">
            <tbody>
              <tr style="background: rgba(255,255,255,0.02);">
                <td colspan="2"><strong style="color: #93c5fd;">I. ASET LANCAR</strong></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Kas & Saldo Bank Koperasi
                  <br/><small class="text-muted">Likuiditas kas untuk operasional</small>
                </td>
                <td class="num-col" style="color: #fbbf24; font-weight: 700;"><%= formatRp(neraca.aktiva.kas) %></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Piutang Pinjaman Anggota
                  <br/><small class="text-muted">Sisa pokok pinjaman berjalan</small>
                </td>
                <td class="num-col" style="color: #f87171; font-weight: 700;"><%= formatRp(neraca.aktiva.piutang) %></td>
              </tr>
              <tr>
                <td colspan="2" style="height: 48px; border: none;"></td>
              </tr>
            </tbody>
            <tfoot>
              <tr style="background: rgba(59,130,246,0.12); border-top: 2px solid #3b82f6;">
                <td style="font-size: 13px; font-weight: 800; color: #93c5fd;">JUMLAH TOTAL AKTIVA:</td>
                <td class="num-col" style="font-size: 15px; font-weight: 800; color: #93c5fd;"><%= formatRp(neraca.aktiva.total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- SISI KANAN: PASIVA -->
      <div class="neraca-side">
        <div style="font-size: 13px; font-weight: 700; color: #34d399; text-transform: uppercase; margin-bottom: 12px; display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
          <span>PASIVA (KEWAJIBAN & EKUITAS)</span>
          <span>JUMLAH (RP)</span>
        </div>
        <div class="table-responsive">
          <table class="table-clean">
            <tbody>
              <tr style="background: rgba(255,255,255,0.02);">
                <td colspan="2"><strong style="color: #fbbf24;">I. KEWAJIBAN JANGKA PENDEK</strong></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Simpanan Sukarela Anggota
                  <br/><small class="text-muted">Titipan anggota (dapat ditarik sewaktu-waktu)</small>
                </td>
                <td class="num-col" style="color: #fbbf24;"><%= formatRp(neraca.pasiva.kewajiban.simpananSukarela) %></td>
              </tr>
              <tr style="background: rgba(255,255,255,0.02);">
                <td colspan="2"><strong style="color: #6ee7b7;">II. EKUITAS / MODAL SENDIRI</strong></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Simpanan Pokok Anggota
                  <br/><small class="text-muted">Modal awal permanen (@ Rp 1.005.000)</small>
                </td>
                <td class="num-col" style="color: #93c5fd;"><%= formatRp(neraca.pasiva.ekuitas.simpananPokok) %></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Simpanan Wajib Anggota
                  <br/><small class="text-muted">Akumulasi iuran rutin (@ Rp 100.000/bln)</small>
                </td>
                <td class="num-col" style="color: #6ee7b7;"><%= formatRp(neraca.pasiva.ekuitas.simpananWajib) %></td>
              </tr>
              <tr>
                <td style="padding-left: 18px;">
                  Sisa Hasil Usaha (SHU) / Laba Berjalan
                  <br/><small class="text-muted">Akumulasi laba operasional s.d. hari ini</small>
                </td>
                <td class="num-col" style="color: #a78bfa; font-weight: 700;"><%= formatRp(neraca.pasiva.ekuitas.shuBerjalan) %></td>
              </tr>
            </tbody>
            <tfoot>
              <tr style="background: rgba(16,185,129,0.12); border-top: 2px solid #10b981;">
                <td style="font-size: 13px; font-weight: 800; color: #6ee7b7;">JUMLAH TOTAL PASIVA:</td>
                <td class="num-col" style="font-size: 15px; font-weight: 800; color: #6ee7b7;"><%= formatRp(neraca.pasiva.total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="financial-grid-2">
  
  <!-- ============================================== -->
  <!-- 2. LAPORAN RUGI LABA (PERHITUNGAN HASIL USAHA) -->
  <!-- ============================================== -->
  <div class="card animate-in" style="margin-bottom: 0;">
    <div class="card-header">
      <h3><i class="bi bi-graph-up"></i> 2. Laporan Laba Rugi / PHU</h3>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table-clean">
          <thead>
            <tr>
              <th>Uraian Komponen Keuangan</th>
              <th class="num-col">Jumlah (Rp)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background: rgba(255,255,255,0.02); font-weight: 700;">
              <td colspan="2"><strong style="color: #34d399;">A. PENDAPATAN OPERASIONAL</strong></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">
                Pendapatan Bunga Pinjaman
                <br/><small class="text-muted">Realisasi bunga metode menurun (2% sliding)</small>
              </td>
              <td class="num-col" style="color: #34d399;">+ <%= formatRp(rugiLaba.pendapatanBunga) %></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">
                <strong>Premi Pinjaman / Administrasi (1%)</strong>
                <br/><small class="text-muted">Potongan di muka saat pencairan pinjaman baru</small>
              </td>
              <td class="num-col" style="color: #34d399;">+ <%= formatRp(rugiLaba.pendapatanPremi) %></td>
            </tr>
            <tr style="background: rgba(52,211,153,0.05); font-weight: 600;">
              <td>Total Pendapatan Operasional</td>
              <td class="num-col" style="color: #34d399; font-weight: 700;"><%= formatRp(rugiLaba.totalPendapatan) %></td>
            </tr>
            
            <tr style="background: rgba(255,255,255,0.02); font-weight: 700;">
              <td colspan="2"><strong style="color: #94a3b8;">B. BEBAN OPERASIONAL</strong></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">
                Beban Administrasi & Operasional Kantor
                <br/><small class="text-muted">Pengadaan ATK, rapat, dan operasional pengurus</small>
              </td>
              <td class="num-col text-muted">- <%= formatRp(rugiLaba.bebanOperasional) %></td>
            </tr>
            <tr style="background: rgba(239,68,68,0.05); font-weight: 600;">
              <td>Total Beban Operasional</td>
              <td class="num-col text-muted">- <%= formatRp(rugiLaba.bebanOperasional) %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="background: rgba(139,92,246,0.12); font-weight: 800; border-top: 2px solid #8b5cf6;">
              <td style="font-size: 13px; color: #c4b5fd;">SISA HASIL USAHA (SHU BERSIH):</td>
              <td class="num-col" style="color: #c4b5fd; font-size: 15px;"><%= formatRp(rugiLaba.shuBersih) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- 3. LAPORAN ARUS KAS (CASH FLOW & LIKUIDITAS)   -->
  <!-- ============================================== -->
  <div class="card animate-in" style="margin-bottom: 0;">
    <div class="card-header">
      <h3><i class="bi bi-wallet2"></i> 3. Laporan Arus Kas (Cash Flow)</h3>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table-clean">
          <thead>
            <tr>
              <th>Aliran Arus Kas Masuk & Keluar</th>
              <th class="num-col">Jumlah (Rp)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background: rgba(255,255,255,0.02); font-weight: 700;">
              <td colspan="2"><strong style="color: #60a5fa;">A. ARUS KAS MASUK (PENERIMAAN)</strong></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Setoran Simpanan Anggota (Pokok/Wajib/Sukarela)</td>
              <td class="num-col" style="color: #60a5fa;"><%= formatRp(arusKas.masuk.simpanan) %></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Penerimaan Angsuran Pokok Pinjaman</td>
              <td class="num-col" style="color: #60a5fa;"><%= formatRp(arusKas.masuk.pokokAngsuran) %></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Penerimaan Bunga Pinjaman Anggota</td>
              <td class="num-col" style="color: #60a5fa;"><%= formatRp(arusKas.masuk.bunga) %></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Penerimaan Premi Pinjaman (1%)</td>
              <td class="num-col" style="color: #60a5fa;"><%= formatRp(arusKas.masuk.premi) %></td>
            </tr>
            <tr style="background: rgba(59,130,246,0.05); font-weight: 600;">
              <td>Total Arus Kas Masuk</td>
              <td class="num-col" style="color: #60a5fa; font-weight: 700;"><%= formatRp(arusKas.masuk.total) %></td>
            </tr>

            <tr style="background: rgba(255,255,255,0.02); font-weight: 700;">
              <td colspan="2"><strong style="color: #f87171;">B. ARUS KAS KELUAR (PENGELUARAN)</strong></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Penyaluran Pembiayaan Pinjaman (Plafon Baru)</td>
              <td class="num-col" style="color: #f87171;"><%= formatRp(arusKas.keluar.pencairanPinjaman) %></td>
            </tr>
            <tr>
              <td style="padding-left: 18px;">Penarikan Simpanan Sukarela Anggota</td>
              <td class="num-col" style="color: #f87171;"><%= formatRp(arusKas.keluar.penarikanSukarela) %></td>
            </tr>
            <tr style="background: rgba(239,68,68,0.05); font-weight: 600;">
              <td>Total Arus Kas Keluar</td>
              <td class="num-col" style="color: #f87171; font-weight: 700;"><%= formatRp(arusKas.keluar.total) %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="background: rgba(245,158,11,0.12); font-weight: 800; border-top: 2px solid #f59e0b;">
              <td style="font-size: 13px; color: #fde68a;">SALDO AKHIR KAS BERJALAN:</td>
              <td class="num-col" style="color: #fde68a; font-size: 15px;"><%= formatRp(arusKas.saldoKas) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- ============================================== -->
<!-- 4. REKAPITULASI DETAIL SIMPANAN & PINJAMAN     -->
<!-- ============================================== -->
<div class="financial-grid-2">
  
  <!-- Rincian Simpanan -->
  <div class="card animate-in" style="margin-bottom: 0;">
    <div class="card-header">
      <h3><i class="bi bi-piggy-bank"></i> Rekapitulasi Jenis Simpanan</h3>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table-clean">
          <thead>
            <tr>
              <th>Kategori Simpanan</th>
              <th>Karakteristik & Ketentuan</th>
              <th class="num-col">Saldo Terkumpul</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Simpanan Pokok</strong></td>
              <td><small class="text-muted">Rp 1.005.000 (1x / cicil)</small></td>
              <td class="num-col" style="color:#93c5fd;"><%= formatRp(simpanan.pokok) %></td>
            </tr>
            <tr>
              <td><strong>Simpanan Wajib</strong></td>
              <td><small class="text-muted">Rp 100.000 / bln via payroll</small></td>
              <td class="num-col" style="color:#6ee7b7;"><%= formatRp(simpanan.wajib) %></td>
            </tr>
            <tr>
              <td><strong>Simpanan Sukarela</strong></td>
              <td><small class="text-muted">Tabungan fleksibel setor/tarik</small></td>
              <td class="num-col" style="color:#fbbf24;"><%= formatRp(simpanan.sukarela) %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="background: rgba(255,255,255,0.03); font-weight:700;">
              <td colspan="2">TOTAL SALDO SIMPANAN ANGGOTA:</td>
              <td class="num-col" style="color:#a78bfa; font-size:14px;"><%= formatRp(simpanan.total) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- Rincian Pembiayaan -->
  <div class="card animate-in" style="margin-bottom: 0;">
    <div class="card-header">
      <h3><i class="bi bi-receipt"></i> Rekapitulasi Pembiayaan Pinjaman</h3>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table-clean">
          <thead>
            <tr>
              <th>Komponen Pinjaman & Hasil Usaha</th>
              <th class="num-col">Nominal (Rp)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Plafon Pinjaman Disalurkan</td>
              <td class="num-col"><%= formatRp(pinjaman.totalPlafon) %></td>
            </tr>
            <tr>
              <td>Pokok Angsuran Terbayar</td>
              <td class="num-col" style="color:#34d399;"><%= formatRp(pinjaman.pokokTerbayar) %></td>
            </tr>
            <tr>
              <td><strong>Sisa Piutang Berjalan (Outstanding)</strong></td>
              <td class="num-col font-bold" style="color:#f87171;"><%= formatRp(pinjaman.sisaPiutang) %></td>
            </tr>
            <tr>
              <td>Pendapatan Bunga Pinjaman (2% Menurun)</td>
              <td class="num-col" style="color:#34d399;">+ <%= formatRp(pinjaman.bungaPendapatan) %></td>
            </tr>
            <tr>
              <td>Pendapatan Premi Pinjaman / Biaya Admin (1%)</td>
              <td class="num-col" style="color:#34d399;">+ <%= formatRp(pinjaman.totalPremi) %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr style="background: rgba(16,185,129,0.06); font-weight:700;">
              <td>TOTAL PENDAPATAN OPERASIONAL:</td>
              <td class="num-col" style="color:#34d399; font-size:14px;"><%= formatRp(pinjaman.labaOperasional) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- ============================================== -->
<!-- 5. DAFTAR PINJAMAN AKTIF BERJALAN              -->
<!-- ============================================== -->
<div class="card animate-in" style="margin-top: 24px;">
  <div class="card-header d-flex justify-between align-center flex-wrap gap-2">
    <h3><i class="bi bi-list-check"></i> Daftar Pinjaman Aktif Berjalan (<%= pinjamanAktif.length %>)</h3>
    <a href="/admin/pinjaman" class="btn-primary-sm">Kelola Data Pinjaman &rarr;</a>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table-clean">
        <thead>
          <tr>
            <th width="40" class="text-center">No</th>
            <th>Peminjam (Anggota)</th>
            <th>NIP</th>
            <th>Unit Kerja</th>
            <th class="num-col">Plafon Pinjaman</th>
            <th class="text-center">Tenor</th>
            <th class="num-col">Sisa Hutang Pokok</th>
            <th class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (pinjamanAktif.length === 0) { %>
            <tr><td colspan="8" class="text-center py-4 text-muted">Tidak ada pinjaman aktif saat ini.</td></tr>
          <% } else { %>
            <% pinjamanAktif.forEach((p, idx) => { %>
              <tr>
                <td class="text-center"><%= idx + 1 %></td>
                <td><strong><%= p.nama %></strong></td>
                <td><code><%= p.nip %></code></td>
                <td><%= p.unit_kerja || 'Kanreg V BKN' %></td>
                <td class="num-col"><%= formatRp(p.nominal_pengajuan) %></td>
                <td class="text-center"><%= p.tenor_bulan %> Bln</td>
                <td class="num-col font-bold" style="color:#f87171;"><%= formatRp(p.sisa_hutang) %></td>
                <td class="text-center">
                  <a href="/admin/pengajuan/<%= p.id %>" class="btn-sm btn-outline-primary" style="padding: 4px 10px; font-size: 11px;">Lihat Jadwal</a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
