<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo-bkn.png"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <style>
    @page {
      size: A4 portrait;
      margin: 15mm;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f8fafc;
      color: #0f172a;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.4;
    }
    .no-print-bar {
      width: 100%;
      max-width: 900px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .btn-action {
      padding: 10px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-size: 14px;
    }
    .btn-primary { background: #2563eb; color: #fff; }
    .btn-secondary { background: #e2e8f0; color: #334155; }

    .doc-container {
      width: 100%;
      max-width: 900px;
      background: #fff;
      border: 1px solid #cbd5e1;
      padding: 30px 40px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    }
    .kop {
      display: flex;
      align-items: center;
      border-bottom: 2px solid #0f172a;
      padding-bottom: 12px;
      margin-bottom: 18px;
    }
    .kop-logo { width: 64px; height: 64px; object-fit: contain; margin-right: 18px; }
    .kop-text h2 { font-size: 15px; text-transform: uppercase; }
    .kop-text h1 { font-size: 18px; font-weight: bold; color: #1e3a8a; }
    .kop-text p { font-size: 11px; color: #475569; }

    .title-box { text-align: center; margin-bottom: 20px; }
    .title-box h3 { font-size: 16px; text-transform: uppercase; text-decoration: underline; margin-bottom: 4px; }
    .title-box p { font-size: 12px; color: #475569; }

    table.data {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-bottom: 24px;
    }
    table.data th, table.data td {
      border: 1px solid #94a3b8;
      padding: 6px 8px;
    }
    table.data th {
      background: #f1f5f9;
      font-weight: bold;
      text-align: center;
    }
    .text-right { text-align: right; }
    .text-center { text-align: center; }

    .signature-grid {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
      font-size: 12px;
      text-align: center;
    }
    .sig-col { width: 220px; }
    .sig-space { height: 60px; }
    .sig-name { font-weight: bold; text-decoration: underline; }

    @media print {
      body { background: #fff; padding: 0; }
      .no-print-bar { display: none !important; }
      .doc-container { border: none; box-shadow: none; padding: 0; width: 100%; }
    }
  </style>
</head>
<body>

  <div class="no-print-bar">
    <button onclick="window.close()" class="btn-action btn-secondary">
      <i class="bi bi-x-lg"></i> Tutup
    </button>
    <button onclick="window.print()" class="btn-action btn-primary">
      <i class="bi bi-printer"></i> Cetak Dokumen RAT
    </button>
  </div>

  <div class="doc-container">
    <div class="kop">
      <img src="/images/logo-bkn.png" alt="Logo BKN" class="kop-logo"/>
      <div class="kop-text">
        <h2>Badan Kepegawaian Negara &bull; Kantor Regional V Jakarta</h2>
        <h1>Koperasi Pegawai Kanreg V BKN</h1>
        <p>Jl. Raya Ciracas No. 36, Ciracas, Jakarta Timur 13740 &bull; Telp: (021) 87721079</p>
      </div>
    </div>

    <div class="title-box">
      <h3>Daftar Rincian Pembagian Sisa Hasil Usaha (SHU) Anggota</h3>
      <p>Lampiran Laporan Pertanggungjawaban Pengurus &bull; Tahun Buku <%= tahun %></p>
    </div>

    <table class="data">
      <thead>
        <tr>
          <th width="35">No</th>
          <th>Nama Anggota Pegawai</th>
          <th>NIP</th>
          <th>Unit Kerja</th>
          <th>Simpanan (Rp)</th>
          <th>SHU Modal (Rp)</th>
          <th>SHU Usaha (Rp)</th>
          <th>Total SHU (Rp)</th>
          <th width="80">Tanda Tangan</th>
        </tr>
      </thead>
      <tbody>
        <% let grandSimpanan = 0, grandModal = 0, grandUsaha = 0, grandTotal = 0; %>
        <% daftarSHU.forEach((d, idx) => { %>
          <% 
            grandSimpanan += d.total_simpanan;
            grandModal += d.jasa_modal;
            grandUsaha += d.jasa_pinjam;
            grandTotal += d.total_shu;
          %>
          <tr>
            <td class="text-center"><%= idx + 1 %></td>
            <td><strong><%= d.nama %></strong></td>
            <td><%= d.nip %></td>
            <td><%= d.unit_kerja || 'Kanreg V BKN' %></td>
            <td class="text-right"><%= Number(d.total_simpanan).toLocaleString('id-ID') %></td>
            <td class="text-right"><%= Number(d.jasa_modal).toLocaleString('id-ID') %></td>
            <td class="text-right"><%= Number(d.jasa_pinjam).toLocaleString('id-ID') %></td>
            <td class="text-right" style="font-weight:bold;"><%= Number(d.total_shu).toLocaleString('id-ID') %></td>
            <td></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr style="font-weight:bold; background:#f8fafc;">
          <td colspan="4" class="text-center">JUMLAH KESELURUHAN</td>
          <td class="text-right"><%= Number(grandSimpanan).toLocaleString('id-ID') %></td>
          <td class="text-right"><%= Number(grandModal).toLocaleString('id-ID') %></td>
          <td class="text-right"><%= Number(grandUsaha).toLocaleString('id-ID') %></td>
          <td class="text-right"><%= Number(grandTotal).toLocaleString('id-ID') %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>

    <div class="signature-grid">
      <div class="sig-col">
        <p>Mengetahui,</p>
        <p>Ketua Koperasi Pegawai BKN</p>
        <div class="sig-space"></div>
        <p class="sig-name">Ketua Koperasi BKN</p>
        <p>Kanreg V Jakarta</p>
      </div>

      <div class="sig-col">
        <p>Jakarta, <%= new Date().toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'}) %></p>
        <p>Bendahara Koperasi,</p>
        <div class="sig-space"></div>
        <p class="sig-name">Bendahara Koperasi</p>
        <p>Kanreg V Jakarta</p>
      </div>
    </div>
  </div>

</body>
</html>
