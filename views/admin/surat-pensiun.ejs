<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo-bkn.png"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <style>
    @page {
      size: A4 portrait;
      margin: 15mm 18mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #0f172a;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.5;
    }

    /* TOP ACTION BAR */
    .no-print-bar {
      width: 100%;
      max-width: 840px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-family: 'Segoe UI', Tahoma, sans-serif;
    }
    .btn-action {
      padding: 9px 18px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-size: 14px;
      transition: all 0.2s;
    }
    .btn-primary { background: #059669; color: #fff; }
    .btn-primary:hover { background: #047857; }
    .btn-secondary { background: #334155; color: #e2e8f0; }
    .btn-secondary:hover { background: #475569; }

    /* TOGGLE BUTTON GROUP */
    .btn-group-toggle {
      display: inline-flex;
      background: #1e293b;
      padding: 4px;
      border-radius: 8px;
      border: 1px solid #334155;
      gap: 4px;
    }
    .btn-toggle {
      background: transparent;
      border: none;
      color: #94a3b8;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-toggle:hover {
      color: #f8fafc;
      background: rgba(255,255,255,0.06);
    }
    .btn-toggle.active {
      background: #059669;
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(5,150,105,0.3);
    }

    /* ========================================================= */
    /* 1. KWITANSI RESMI BKN (FORMAT PERSIS FISIK)               */
    /* ========================================================= */
    .kwitansi-sheet {
      width: 100%;
      max-width: 840px;
      background: #ffffff;
      color: #000000;
      padding: 45px 52px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.35);
      border-radius: 4px;
      position: relative;
      margin-bottom: 24px;
    }

    .kw-header {
      text-align: center;
      margin-bottom: 22px;
    }
    .kw-instansi {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.8px;
      color: #000;
      text-transform: uppercase;
      margin: 0;
      line-height: 1.35;
    }
    .kw-line-thick {
      height: 4px;
      background: #000000;
      width: 100%;
      margin: 12px 0 16px 0;
    }
    .kw-title {
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      text-decoration: underline;
      margin: 0;
    }

    .kw-table {
      width: 100%;
      border-collapse: collapse;
      border: 1.5px solid #000000;
      font-size: 13.5px;
    }
    .kw-table td {
      padding: 7px 12px;
      vertical-align: top;
      color: #000;
    }
    .kw-label {
      width: 155px;
      font-weight: 400;
    }
    .kw-sep {
      width: 16px;
      text-align: center;
    }
    .kw-val {
      font-weight: 400;
    }

    .kw-row-jumlah td {
      border-top: 2px solid #000000;
      border-bottom: 2px solid #000000;
      background: #e2e8f0;
      font-size: 14.5px;
      padding: 9px 12px;
    }
    .kw-row-note td {
      border-top: 1px solid #000000;
      font-size: 12px;
      font-style: italic;
      padding: 6px 12px;
    }

    .kw-footer {
      margin-top: 36px;
    }
    .kw-date-block {
      text-align: right;
      padding-right: 48px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .kw-sigs-grid {
      display: flex;
      justify-content: space-between;
      padding: 0 40px;
    }
    .kw-sig-col {
      width: 40%;
      text-align: center;
    }
    .kw-sig-role {
      font-size: 14px;
      margin-bottom: 75px;
    }
    .kw-sig-name {
      font-size: 14px;
      font-weight: 600;
    }

    /* ========================================================= */
    /* 2. BERITA ACARA RINCIAN DANA PENSIUN (LAMPIRAN AUDIT)     */
    /* ========================================================= */
    .doc-container {
      width: 100%;
      max-width: 840px;
      background: #ffffff;
      color: #0f172a;
      border: 3px double #065f46;
      padding: 38px 48px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.35);
      position: relative;
      font-family: 'Times New Roman', Times, serif;
      margin-bottom: 24px;
    }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.04;
      width: 340px;
      pointer-events: none;
    }

    .kop-surat {
      display: flex;
      align-items: center;
      border-bottom: 3px double #0f172a;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }
    .kop-logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      margin-right: 18px;
    }
    .kop-text {
      text-align: center;
      flex: 1;
    }
    .kop-text h2 {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #0f172a;
    }
    .kop-text h1 {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #065f46;
      margin: 2px 0;
    }
    .kop-text p {
      font-size: 11.5px;
      color: #334155;
    }

    .doc-title {
      text-align: center;
      margin-bottom: 18px;
    }
    .doc-title h3 {
      font-size: 15px;
      font-weight: 800;
      text-decoration: underline;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .doc-title .doc-nomor {
      font-size: 12.5px;
      color: #334155;
      margin-top: 3px;
    }

    .table-bio {
      width: 100%;
      margin: 12px 0 16px 12px;
      font-size: 13.5px;
      border-collapse: collapse;
    }
    .table-bio td {
      padding: 3px 0;
      vertical-align: top;
    }
    .table-bio td.label {
      width: 160px;
      color: #334155;
    }
    .table-bio td.separator {
      width: 16px;
      text-align: center;
    }

    .table-finance {
      width: 100%;
      border-collapse: collapse;
      margin: 14px 0 16px 0;
      font-size: 13px;
    }
    .table-finance th {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      padding: 7px 10px;
      text-align: left;
      font-weight: 700;
    }
    .table-finance td {
      border: 1px solid #cbd5e1;
      padding: 6px 10px;
      vertical-align: middle;
    }
    .table-finance td.amount {
      text-align: right;
      font-family: 'Courier New', Courier, monospace;
      font-weight: 600;
    }
    .table-finance tr.total-row {
      background: #ecfdf5;
      font-weight: 800;
    }
    .table-finance tr.total-row td {
      border-top: 2px solid #059669;
      font-size: 14px;
      color: #065f46;
    }

    .terbilang-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid #059669;
      padding: 8px 12px;
      font-style: italic;
      font-size: 12.5px;
      margin-bottom: 16px;
    }

    .doc-signatures {
      display: flex;
      justify-content: space-between;
      margin-top: 24px;
      font-size: 13px;
      page-break-inside: avoid;
    }
    .sig-block {
      text-align: center;
      width: 30%;
    }
    .sig-role {
      font-weight: 600;
      margin-bottom: 60px;
    }
    .sig-name {
      font-weight: 700;
      text-decoration: underline;
    }
    .sig-nip {
      font-size: 11.5px;
      color: #475569;
    }

    .doc-footer-meta {
      margin-top: 20px;
      padding-top: 10px;
      border-top: 1px dashed #cbd5e1;
      font-size: 10px;
      color: #64748b;
      display: flex;
      justify-content: space-between;
      font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    /* ========================================================= */
    /* PRINT MEDIA QUERIES                                       */
    /* ========================================================= */
    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .no-print-bar {
        display: none !important;
      }
      .kwitansi-sheet {
        box-shadow: none !important;
        padding: 20px 20px !important;
        max-width: 100% !important;
        border: none !important;
      }
      .doc-container {
        border: none !important;
        box-shadow: none !important;
        padding: 20px 20px !important;
        max-width: 100% !important;
      }
      .watermark {
        opacity: 0.05 !important;
      }

      /* Mode Cetak */
      body.mode-kwitansi #sectionBeritaAcara {
        display: none !important;
      }
      body.mode-kwitansi #sectionKwitansi {
        display: block !important;
      }

      body.mode-berita-acara #sectionKwitansi {
        display: none !important;
      }
      body.mode-berita-acara #sectionBeritaAcara {
        display: block !important;
      }

      body.mode-keduanya #sectionKwitansi {
        display: block !important;
        page-break-after: always;
      }
      body.mode-keduanya #sectionBeritaAcara {
        display: block !important;
      }
    }
  </style>
</head>
<body class="mode-kwitansi">

  <!-- TOP BAR: MODE SWITCHER & PRINT BUTTON (TIDAK TERCETAK) -->
  <div class="no-print-bar">
    <div style="display: flex; align-items: center; gap: 8px;">
      <a href="/admin/pensiun" class="btn-action btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Menu Pensiun
      </a>
    </div>

    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <div class="btn-group-toggle">
        <button type="button" id="btnModeKwitansi" class="btn-toggle active" onclick="switchMode('kwitansi')">
          <i class="bi bi-receipt"></i> Kwitansi Resmi BKN
        </button>
        <button type="button" id="btnModeBeritaAcara" class="btn-toggle" onclick="switchMode('berita-acara')">
          <i class="bi bi-file-earmark-text"></i> Berita Acara Rincian
        </button>
        <button type="button" id="btnModeKeduanya" class="btn-toggle" onclick="switchMode('keduanya')">
          <i class="bi bi-collection"></i> Tampilkan Keduanya
        </button>
      </div>

      <button onclick="window.print()" class="btn-action btn-primary">
        <i class="bi bi-printer-fill"></i> Cetak Dokumen
      </button>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 1. KWITANSI PENGEMBALIAN SIMPANAN KOPERASI (PERSIS FISIK) -->
  <!-- ========================================================= -->
  <div id="sectionKwitansi" class="kwitansi-sheet">
    <div class="kw-header">
      <h1 class="kw-instansi">KOPERASI PRIMER SIMPAN PINJAM</h1>
      <h1 class="kw-instansi">KANTOR REGIONAL V BKN JAKARTA</h1>
      <div class="kw-line-thick"></div>
      <h2 class="kw-title">KWITANSI PENGEMBALIAN SIMPANAN KOPERASI</h2>
    </div>

    <table class="kw-table">
      <tbody>
        <tr>
          <td class="kw-label">Sudah terima dari</td>
          <td class="kw-sep">:</td>
          <td class="kw-val" style="font-style: italic;">Koperasi Primer Simpan Pinjam Kanreg V BKN Jakarta</td>
        </tr>
        <tr>
          <td class="kw-label">Terbilang</td>
          <td class="kw-sep">:</td>
          <td class="kw-val" style="font-style: italic;"><%= terbilang %></td>
        </tr>
        <tr class="kw-row-jumlah">
          <td class="kw-label" style="font-weight: bold; font-style: italic;">Jumlah</td>
          <td class="kw-sep" style="font-weight: bold;">:</td>
          <td class="kw-val" style="font-weight: bold; font-style: italic; font-size: 15px;">
            Rp. <%= new Intl.NumberFormat('id-ID').format(data.total_dana_diterima) %>,-
          </td>
        </tr>
        <tr>
          <td class="kw-label">Untuk</td>
          <td class="kw-sep">:</td>
          <td class="kw-val" style="font-style: italic;">
            Pengembalian simpanan koperasi atas nama Bpk/Ibu <%= data.nama_anggota %>
          </td>
        </tr>
        <tr>
          <td class="kw-label">Alamat</td>
          <td class="kw-sep">:</td>
          <td class="kw-val" style="font-style: italic;">
            <%= data.unit_kerja_anggota || 'Kantor Regional V BKN Jakarta' %>
          </td>
        </tr>
        <tr class="kw-row-note">
          <td colspan="3">
            Kwitansi ini sah apabila ada tanda tangan pengurus koperasi.
          </td>
        </tr>
      </tbody>
    </table>

    <div class="kw-footer">
      <div class="kw-date-block">
        Jakarta, <%= new Date(data.tanggal_penarikan).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
      </div>
      <div class="kw-sigs-grid">
        <div class="kw-sig-col">
          <p class="kw-sig-role">Penerima simpanan</p>
          <p class="kw-sig-name">( <%= data.nama_anggota %> )</p>
        </div>
        <div class="kw-sig-col">
          <p class="kw-sig-role">Penerima</p>
          <p class="kw-sig-name">( <span contenteditable="true" title="Klik untuk ubah nama jika diperlukan"><%= data.admin_nama && data.admin_nama !== 'Admin Koperasi' ? data.admin_nama : 'Nurmiati, S.AP' %></span> )</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 2. BERITA ACARA PENGEMBALIAN DANA SIMPANAN (LAMPIRAN)     -->
  <!-- ========================================================= -->
  <div id="sectionBeritaAcara" class="doc-container" style="display: none;">
    <img src="/images/logo-bkn.png" class="watermark" alt="Watermark BKN" />

    <!-- KOP RESMI -->
    <div class="kop-surat">
      <img src="/images/logo-bkn.png" class="kop-logo" alt="Logo BKN" />
      <div class="kop-text">
        <h2>BADAN KEPEGAWAIAN NEGARA</h2>
        <h1>KOPERASI PEGAWAI KANREG V JAKARTA</h1>
        <p>Jl. Mayjen Sutoyo No. 12, Cililitan, Kramat Jati, Jakarta Timur 13640 | Telp: (021) 8093008</p>
        <p>Badan Hukum No. 124/BH/KWK.9/X/1998 &bull; Email: koperasi@bkn.go.id</p>
      </div>
    </div>

    <!-- JUDUL -->
    <div class="doc-title">
      <h3>BERITA ACARA PENGEMBALIAN DANA SIMPANAN ANGGOTA PENSIUN</h3>
      <div class="doc-nomor">Nomor: <strong><%= data.nomor_surat %></strong></div>
    </div>

    <!-- ISI SURAT -->
    <div class="doc-content">
      <p style="text-align: justify; margin-bottom: 10px;">
        Pada hari ini, <strong><%= new Date(data.tanggal_penarikan).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></strong>, 
        bertempat di Kantor Koperasi Pegawai BKN Kantor Regional V Jakarta, telah dilaksanakan penyerahan dan pengembalian seluruh hak simpanan atas pengakhiran keanggotaan koperasi sehubungan dengan <strong><%= data.alasan %></strong>, kepada pegawai/anggota berikut:
      </p>

      <table class="table-bio">
        <tr>
          <td class="label">Nama Lengkap</td>
          <td class="separator">:</td>
          <td><strong><%= data.nama_anggota %></strong></td>
        </tr>
        <tr>
          <td class="label">NIP (Nomor Induk Pegawai)</td>
          <td class="separator">:</td>
          <td><code><%= data.nip_anggota %></code></td>
        </tr>
        <tr>
          <td class="label">Jabatan Terakhir</td>
          <td class="separator">:</td>
          <td><%= data.jabatan_anggota || 'Pegawai Negeri Sipil (PNS)' %></td>
        </tr>
        <tr>
          <td class="label">Unit Kerja Terakhir</td>
          <td class="separator">:</td>
          <td><%= data.unit_kerja_anggota || 'Kantor Regional V BKN Jakarta' %></td>
        </tr>
        <tr>
          <td class="label">Alamat Domisili</td>
          <td class="separator">:</td>
          <td><%= data.alamat_anggota || '-' %></td>
        </tr>
      </table>

      <p style="margin-bottom: 6px;">
        Dengan rincian perhitungan pengembalian hak simpanan dan penyelesaian kewajiban pinjaman sebagai berikut:
      </p>

      <!-- TABEL RINCIAN KEUANGAN -->
      <table class="table-finance">
        <thead>
          <tr>
            <th width="40">No</th>
            <th>Uraian Komponen Hak / Kewajiban</th>
            <th width="120">Keterangan</th>
            <th width="170" class="text-right">Nominal (Rp)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td align="center">1</td>
            <td>Pengembalian Simpanan Pokok</td>
            <td>Hak Awal (1x)</td>
            <td class="amount"><%= formatRp(data.total_simpanan_pokok) %></td>
          </tr>
          <tr>
            <td align="center">2</td>
            <td>Pengembalian Simpanan Wajib</td>
            <td>Akumulasi Iuran Rutin</td>
            <td class="amount"><%= formatRp(data.total_simpanan_wajib) %></td>
          </tr>
          <tr>
            <td align="center">3</td>
            <td>Pengembalian Simpanan Sukarela</td>
            <td>Saldo Tabungan Sukarela</td>
            <td class="amount"><%= formatRp(data.total_simpanan_sukarela) %></td>
          </tr>
          <tr style="background: #f8fafc; font-weight: 600;">
            <td colspan="3" align="right"><strong>Subtotal Hak Simpanan Anggota (Bruto) :</strong></td>
            <td class="amount"><strong><%= formatRp(data.total_simpanan_kotor) %></strong></td>
          </tr>
          <tr>
            <td align="center">4</td>
            <td style="color: <%= data.sisa_pinjaman_pokok > 0 ? '#b91c1c' : '#475569' %>;">
              Potongan Pelunasan Sisa Hutang Pinjaman Koperasi
            </td>
            <td><%= data.sisa_pinjaman_pokok > 0 ? 'Pelunasan Penuh' : 'Nihil' %></td>
            <td class="amount" style="color: <%= data.sisa_pinjaman_pokok > 0 ? '#b91c1c' : '#475569' %>;">
              <%= data.sisa_pinjaman_pokok > 0 ? '(' + formatRp(data.sisa_pinjaman_pokok) + ')' : 'Rp 0' %>
            </td>
          </tr>
          <tr class="total-row">
            <td colspan="3" align="right"><strong>TOTAL BERSIH YANG DITERIMA (NETTO) :</strong></td>
            <td class="amount" style="font-size: 15px;"><%= formatRp(data.total_dana_diterima) %></td>
          </tr>
        </tbody>
      </table>

      <!-- TERBILANG -->
      <div class="terbilang-box">
        <strong>Terbilang:</strong> <em>"<%= terbilang %>"</em>
      </div>

      <% if (data.keterangan) { %>
        <p style="font-size: 12px; color: #475569; margin-bottom: 12px;">
          <strong>Catatan Tambahan / Penyaluran:</strong> <%= data.keterangan %>
        </p>
      <% } %>

      <p style="text-align: justify;">
        Dengan diterbitkannya Berita Acara ini, maka hak simpanan pegawai bersangkutan telah diserahterimakan sepenuhnya, seluruh pinjaman dinyatakan lunas, dan status keanggotaan pada Koperasi Pegawai BKN Kanreg V Jakarta dinyatakan resmi <strong>Pensiun / Non-Aktif</strong> serta bebas dari segala pemotongan payroll gaji bulanan.
      </p>
    </div>

    <!-- TANDA TANGAN (3 PIHAK) -->
    <div class="doc-signatures">
      <div class="sig-block">
        <div class="sig-role">
          Penerima Dana Simpanan,<br>
          Pegawai ASN Bersangkutan
        </div>
        <div class="sig-name"><%= data.nama_anggota %></div>
        <div class="sig-nip">NIP. <%= data.nip_anggota %></div>
      </div>

      <div class="sig-block">
        <div class="sig-role">
          Pengurus Koperasi,<br>
          Bendahara Koperasi BKN
        </div>
        <div class="sig-name"><%= data.admin_nama %></div>
        <div class="sig-nip">Pengurus Koperasi BKN Kanreg V</div>
      </div>

      <div class="sig-block">
        <div class="sig-role">
          Mengetahui / Menyetujui,<br>
          Ketua Koperasi Pegawai BKN
        </div>
        <div class="sig-name">Drs. H. Hendra Wijaya, M.Si</div>
        <div class="sig-nip">NIP. 197008121995031001</div>
      </div>
    </div>

    <!-- META FOOTER -->
    <div class="doc-footer-meta">
      <span>Dokumen Resmi Sistem Koperasi BKN Kanreg V &bull; No: <%= data.nomor_surat %></span>
      <span>Dicetak otomatis pada: <%= new Date().toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %> WIB</span>
    </div>
  </div>

  <script>
    function switchMode(mode) {
      const secKwitansi = document.getElementById('sectionKwitansi');
      const secBeritaAcara = document.getElementById('sectionBeritaAcara');
      const btnKw = document.getElementById('btnModeKwitansi');
      const btnBa = document.getElementById('btnModeBeritaAcara');
      const btnAll = document.getElementById('btnModeKeduanya');

      btnKw.classList.remove('active');
      btnBa.classList.remove('active');
      btnAll.classList.remove('active');
      document.body.className = 'mode-' + mode;

      if (mode === 'kwitansi') {
        btnKw.classList.add('active');
        secKwitansi.style.display = 'block';
        secBeritaAcara.style.display = 'none';
      } else if (mode === 'berita-acara') {
        btnBa.classList.add('active');
        secKwitansi.style.display = 'none';
        secBeritaAcara.style.display = 'block';
      } else if (mode === 'keduanya') {
        btnAll.classList.add('active');
        secKwitansi.style.display = 'block';
        secBeritaAcara.style.display = 'block';
      }
    }
  </script>
</body>
</html>
