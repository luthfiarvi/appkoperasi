<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>500 — Kesalahan Server</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="auth-page">
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;">
    <div class="card" style="max-width:550px;width:100%;text-align:center;padding:40px 30px;">
      <div style="font-size:64px;margin-bottom:12px;">⚠️</div>
      <h1 style="color:#ef4444;font-size:24px;margin-bottom:12px;">500 — Terjadi Kesalahan Server</h1>
      <p style="color:#94a3b8;margin-bottom:20px;font-size:14px;">
        <%= typeof message !== 'undefined' ? message : 'Sistem mengalami kendala dalam memproses permintaan Anda.' %>
      </p>
      <div style="display:flex;justify-content:center;gap:12px;">
        <a href="javascript:history.back()" class="btn-secondary">
          &larr; Kembali
        </a>
        <a href="/" class="btn-primary">
          Ke Halaman Utama
        </a>
      </div>
    </div>
  </div>
</body>
</html>
