<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="description" content="Sistem Simpan Pinjam Koperasi Pegawai BKN Kanreg V Jakarta"/>
  <meta name="color-scheme" content="dark"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="icon" type="image/png" href="/images/logo-bkn.png"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">
        <img src="/images/logo-bkn.png" alt="Logo BKN" class="brand-logo-img"/>
      </div>
      <div class="brand-text">
        <span class="brand-title">Koperasi BKN</span>
        <span class="brand-sub">Kanreg V Jakarta</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-user-info">
          <div class="user-avatar"><%= user.nama.charAt(0).toUpperCase() %></div>
          <div>
            <div class="user-name"><%= user.nama.split(' ').slice(0,2).join(' ') %></div>
            <div class="user-role"><%= locals.session && locals.session.role === 'admin' ? '🛡️ Admin' : '👤 Pegawai' %></div>
          </div>
        </div>
      <% } %>

      <ul class="nav-list">
        <% if (locals.isAdmin) { %>
          <li><a href="/admin/dashboard"  class="nav-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
          <li><a href="/admin/anggota"    class="nav-link <%= currentPath && currentPath.startsWith('/admin/anggota') ? 'active' : '' %>"><i class="bi bi-people"></i> Data Anggota</a></li>
          <li><a href="/admin/simpanan"   class="nav-link <%= currentPath && currentPath.startsWith('/admin/simpanan') ? 'active' : '' %>"><i class="bi bi-wallet2"></i> Data Simpanan</a></li>
          <li><a href="/admin/pinjaman"   class="nav-link <%= currentPath === '/admin/pinjaman' || currentPath === '/admin/pinjaman/baru' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Data Pinjaman</a></li>
          <li><a href="/admin/pengajuan"  class="nav-link <%= currentPath && currentPath.startsWith('/admin/pengajuan') ? 'active' : '' %>"><i class="bi bi-file-earmark-check"></i> Pengajuan Masuk</a></li>
          <li><a href="/admin/payroll"    class="nav-link <%= currentPath && currentPath.startsWith('/admin/payroll') ? 'active' : '' %>"><i class="bi bi-receipt-cutoff"></i> Tagihan Gaji</a></li>
          <li><a href="/admin/laporan"    class="nav-link <%= currentPath && currentPath.startsWith('/admin/laporan') ? 'active' : '' %>"><i class="bi bi-bank2"></i> Neraca & Laporan</a></li>
          <li><a href="/admin/shu"        class="nav-link <%= currentPath && currentPath.startsWith('/admin/shu') ? 'active' : '' %>"><i class="bi bi-pie-chart"></i> Modul SHU</a></li>
          <li><a href="/admin/audit-logs" class="nav-link <%= currentPath && (currentPath.startsWith('/admin/audit') || currentPath.startsWith('/admin/backup')) ? 'active' : '' %>"><i class="bi bi-shield-check"></i> Audit & Backup</a></li>
        <% } else { %>
          <li><a href="/dashboard"      class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>"><i class="bi bi-house-door"></i> Dashboard</a></li>
          <li><a href="/simpanan-saya"  class="nav-link <%= currentPath === '/simpanan-saya' ? 'active' : '' %>"><i class="bi bi-wallet2"></i> Simpanan Saya</a></li>
          <li><a href="/simulasi"       class="nav-link <%= currentPath === '/simulasi' ? 'active' : '' %>"><i class="bi bi-calculator"></i> Simulasi Pinjaman</a></li>
          <li><a href="/pengajuan"      class="nav-link <%= currentPath === '/pengajuan' ? 'active' : '' %>"><i class="bi bi-send-plus"></i> Ajukan Pinjaman</a></li>
        <% } %>
      </ul>
    </nav>

    <div class="sidebar-footer">
      <form action="/logout" method="POST">
        <button type="submit" class="btn-logout">
          <i class="bi bi-box-arrow-left"></i> Keluar
        </button>
      </form>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="main-wrapper">
    <header class="topbar">
      <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
        <i class="bi bi-list"></i>
      </button>
      <div class="topbar-title"><%= title.split(' - ')[0] %></div>
      <div class="topbar-right">
        <span class="topbar-date" id="topbarDate"></span>
      </div>
    </header>

    <main class="content">
      <%- body %>
    </main>

    <footer class="page-footer">
      <p>© 2026 Koperasi Pegawai BKN Kanreg V Jakarta &mdash; Sistem Simpan Pinjam</p>
    </footer>
  </div>

  <script>
    // Tampilkan tanggal dinamis
    const d = new Date();
    const opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' };
    document.getElementById('topbarDate').textContent = d.toLocaleDateString('id-ID', opts);

    // Sidebar overlay click (mobile)
    document.addEventListener('click', function(e) {
      const sidebar = document.getElementById('sidebar');
      const toggle  = document.querySelector('.sidebar-toggle');
      if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
        sidebar.classList.remove('open');
      }
    });
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
