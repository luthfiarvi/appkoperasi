<%
  currentPath = '/pengajuan';
  isAdmin = false;
  const isTopUp = !!activeLoan;
  const sisaPokokLama = isTopUp ? parseFloat(activeLoan.sisa_hutang_aktif || 0) : 0;
%>

<div class="page-header animate-in">
  <div class="d-flex justify-between align-center flex-wrap gap-2">
    <div>
      <h1><i class="bi bi-send-plus"></i> <%= isTopUp ? 'Pengajuan Top-Up Pinjaman' : 'Pengajuan Pinjaman Baru' %></h1>
      <p><%= isTopUp ? 'Ajukan penambahan plafon pinjaman dengan pelunasan otomatis sisa pinjaman berjalan.' : 'Isi formulir di bawah ini untuk mengajukan permohonan pinjaman.' %></p>
    </div>
    <% if (isTopUp) { %>
      <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 12px; font-size: 13px;">
        <i class="bi bi-arrow-repeat"></i> FASILITAS TOP-UP AKTIF
      </span>
    <% } %>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger animate-in">
    <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
  </div>
<% } %>

<% if (typeof pendingLoan !== 'undefined' && pendingLoan) { %>
  <!-- Kasus jika ada pengajuan yang sedang menunggu approval admin -->
  <div class="card animate-in border-warning" style="background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.3);">
    <div class="card-body p-4 text-center">
      <div style="font-size: 40px; color: #fbbf24; margin-bottom: 12px;">
        <i class="bi bi-hourglass-split"></i>
      </div>
      <h3 style="color: #f1f5f9; margin-bottom: 8px;">Pengajuan Sedang Dalam Proses Verifikasi</h3>
      <p class="text-muted" style="max-width: 580px; margin: 0 auto 16px auto; font-size: 14px;">
        Anda saat ini memiliki pengajuan pinjaman <strong>#<%= pendingLoan.id %></strong> sebesar 
        <strong style="color: #93c5fd;"><%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(pendingLoan.nominal_pengajuan) %></strong> 
        yang sedang ditinjau oleh pengurus koperasi. Mohon tunggu proses persetujuan selesai sebelum mengajukan kembali.
      </p>
      <div class="d-flex justify-center gap-2">
        <a href="/dashboard" class="btn-primary">
          <i class="bi bi-speedometer2"></i> Kembali ke Dashboard
        </a>
      </div>
    </div>
  </div>
<% } else { %>

  <% if (isTopUp) { %>
    <!-- Banner Info Pinjaman Lama & Sistem Top-Up -->
    <div class="card animate-in mb-4" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.95)); border: 1px solid rgba(245, 158, 11, 0.35); box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
      <div class="card-header d-flex justify-between align-center" style="background: rgba(245, 158, 11, 0.1); border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
        <h4 style="color: #fbbf24; margin: 0; font-size: 15px;">
          <i class="bi bi-info-circle-fill"></i> Ketentuan Top-Up Pinjaman Berjalan
        </h4>
        <span class="badge badge-warning" style="font-size: 11px;">Pinjaman #<%= activeLoan.id %></span>
      </div>
      <div class="card-body">
        <div class="row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 12px;">
          <div style="background: rgba(255,255,255,0.03); padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
            <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase;">Plafon Pinjaman Aktif</div>
            <div style="font-size: 17px; font-weight: 700; color: #f1f5f9; margin-top: 2px;">
              <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(activeLoan.nominal_pengajuan) %>
            </div>
          </div>
          <div style="background: rgba(245, 158, 11, 0.08); padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.25);">
            <div style="font-size: 12px; color: #fbbf24; text-transform: uppercase; font-weight: 600;">Sisa Pokok yang Harus Dilunasi</div>
            <div style="font-size: 18px; font-weight: 800; color: #fbbf24; margin-top: 2px;">
              <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(sisaPokokLama) %>
            </div>
          </div>
          <div style="background: rgba(255,255,255,0.03); padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
            <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase;">Premi Pinjaman / Admin</div>
            <div style="font-size: 17px; font-weight: 700; color: #93c5fd; margin-top: 2px;">
              Fix 1% <small style="font-weight: 400; font-size: 12px; color: #cbd5e1;">(dari plafon baru)</small>
            </div>
          </div>
        </div>
        <p style="margin: 0; font-size: 12.5px; color: #cbd5e1; line-height: 1.5;">
          <i class="bi bi-check2-circle" style="color: #34d399;"></i> 
          Melalui sistem <strong>Top-Up</strong>, pinjaman lama Anda akan <strong>otomatis dilunasi</strong> dari pencairan pinjaman baru. Anda hanya perlu membayar cicilan untuk pinjaman baru (beban cicilan lama ditutup).
        </p>
      </div>
    </div>
  <% } %>

  <div class="card animate-in" style="animation-delay:.1s">
    <div class="card-header">
      <h3><i class="bi bi-file-earmark-text"></i> Formulir Permohonan Pinjaman <%= isTopUp ? 'Top-Up' : '' %></h3>
    </div>
    <div class="card-body">
      <form action="/pengajuan" method="POST" id="formPengajuan" novalidate>

        <% if (typeof defaultNominal !== 'undefined' && defaultNominal) { %>
          <div class="alert alert-info animate-in mb-3" style="background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd; padding: 10px 14px; border-radius: 8px; font-size: 13px;">
            <i class="bi bi-info-circle-fill"></i> Data nominal dan tenor telah diisi otomatis berdasarkan kalkulasi simulasi Anda. Anda tetap dapat menyesuaikannya jika diperlukan.
          </div>
        <% } %>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label">
              Nominal Plafon Pinjaman Baru (Rp) <span class="required">*</span>
            </label>
            <div class="input-wrapper">
              <i class="bi bi-cash-coin input-icon"></i>
              <input
                type="text"
                inputmode="numeric"
                name="nominal_pengajuan"
                id="nominalInput"
                class="form-control input-rupiah"
                placeholder="<%= isTopUp ? 'Contoh: ' + (Math.max(20000000, Math.ceil((sisaPokokLama + 5000000)/5000000)*5000000)).toLocaleString('id-ID') : 'Contoh: 10.000.000' %>"
                value="<%= typeof defaultNominal !== 'undefined' && defaultNominal ? defaultNominal : '' %>"
                required
              />
            </div>
            <% if (isTopUp) { %>
              <small class="form-hint" style="color: #fbbf24;">
                <i class="bi bi-arrow-up-circle"></i> Plafon baru wajib lebih besar dari sisa pokok lama (<%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(sisaPokokLama) %>)
              </small>
            <% } else { %>
              <small class="form-hint">Minimal Rp 100.000 – Maksimal Rp 500.000.000</small>
            <% } %>
          </div>

          <div class="form-group">
            <label class="form-label">Tenor Pinjaman Baru <span class="required">*</span></label>
            <div class="input-wrapper">
              <i class="bi bi-calendar-week input-icon"></i>
              <select name="tenor_bulan" id="tenorSelect" class="form-control" required>
                <option value="">-- Pilih Tenor (Maks. 36 Bulan) --</option>
                <% for (let i = 1; i <= 36; i++) { %>
                  <option value="<%= i %>" <%= (typeof defaultTenor !== 'undefined' && defaultTenor == i) ? 'selected' : (i === 12 ? 'selected' : '') %>>
                    <%= i %> Bulan
                  </option>
                <% } %>
              </select>
            </div>
            <small class="form-hint">Maksimal tenor cicilan 36 bulan (3 tahun)</small>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Keperluan / Tujuan Pinjaman</label>
          <textarea
            name="keperluan"
            class="form-control"
            rows="2"
            placeholder="<%= isTopUp ? 'Contoh: Top-up pinjaman untuk tambahan modal renovasi rumah, pendidikan, dll.' : 'Contoh: Modal usaha, biaya pendidikan, renovasi rumah, dll.' %>"
          ></textarea>
        </div>

        <!-- Info Gaji Pegawai & Batas DSR 50% -->
        <div class="mb-4 p-3 rounded" style="background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.25);">
          <div class="d-flex justify-between align-center flex-wrap gap-2">
            <div>
              <div style="font-size:12px; color:#93c5fd; text-transform:uppercase; font-weight:700;">
                <i class="bi bi-wallet2"></i> Gaji Bersih Pegawai Terdaftar
              </div>
              <div style="font-size:18px; font-weight:800; color:#fff;">
                <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(gajiBersih || 6500000) %>
              </div>
            </div>
            <div class="text-right">
              <div style="font-size:12px; color:#a7f3d0; text-transform:uppercase; font-weight:700;">
                <i class="bi bi-shield-check"></i> Batas Maksimal Potongan Gaji (DSR 50%)
              </div>
              <div style="font-size:18px; font-weight:800; color:#34d399;">
                <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format((gajiBersih || 6500000) * 0.5) %> / bln
              </div>
            </div>
          </div>
          <small class="text-muted" style="display:block; margin-top:6px; font-size:11.5px;">
            Berdasarkan kebijakan koperasi, total potongan angsuran pinjaman maksimal adalah <strong>50% dari penghasilan bersih bulanan</strong> agar pegawai terhindar dari kesulitan finansial.
          </small>
        </div>

        <% if (isTopUp) { %>
          <!-- Kalkulator Rincian Pencairan Dana Top-Up -->
          <div class="p-3 mb-4 rounded" id="topupBreakdownBox" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(245, 158, 11, 0.25);">
            <div style="font-size: 13px; font-weight: 700; color: #fbbf24; margin-bottom: 10px;">
              <i class="bi bi-calculator"></i> Simulasi Pencairan Bersih Top-Up Pinjaman:
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
              <div style="background: rgba(255,255,255,0.03); padding: 8px 12px; border-radius: 6px;">
                <span class="text-muted" style="font-size: 11px;">Plafon Pinjaman Baru:</span>
                <div id="tuPlafon" style="font-weight: 700; color: #f1f5f9;">Rp 0</div>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 8px 12px; border-radius: 6px;">
                <span class="text-muted" style="font-size: 11px;">Premi Pinjaman (Fix 1%):</span>
                <div id="tuAdmin" style="font-weight: 700; color: #f87171;">( - ) Rp 0</div>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 8px 12px; border-radius: 6px;">
                <span class="text-muted" style="font-size: 11px;">Pelunasan Pinjaman Lama:</span>
                <div id="tuPelunasan" style="font-weight: 700; color: #fbbf24;">( - ) <%= new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',minimumFractionDigits:0}).format(sisaPokokLama) %></div>
              </div>
              <div style="background: rgba(16, 185, 129, 0.1); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.25);">
                <span style="font-size: 11px; color: #6ee7b7; font-weight: 600;">Estimasi Diterima Bersih:</span>
                <div id="tuDiterima" style="font-size: 15px; font-weight: 800; color: #34d399;">Rp 0</div>
              </div>
            </div>
            <div id="topupWarning" style="display:none; margin-top: 8px; font-size: 12px; color: #f87171; background: rgba(239, 68, 68, 0.1); padding: 6px 10px; border-radius: 6px;"></div>
          </div>
        <% } %>

        <!-- Preview Angsuran & DSR Real-time -->
        <div class="preview-box" id="previewBox" style="display:none">
          <div class="preview-title"><i class="bi bi-eye"></i> Perkiraan Angsuran & Analisis Debt Service Ratio (DSR)</div>
          <div class="preview-grid">
            <div class="preview-item">
              <span class="preview-label">Angsuran Pokok</span>
              <span class="preview-value" id="prvPokok">-</span>
            </div>
            <div class="preview-item">
              <span class="preview-label">Bunga (2% Sliding)</span>
              <span class="preview-value" id="prvBunga">-</span>
            </div>
            <div class="preview-item highlight">
              <span class="preview-label">Total Cicilan Bulan 1</span>
              <span class="preview-value" id="prvTotal">-</span>
            </div>
          </div>

          <!-- Alert Hasil Analisis Kemampuan Bayar -->
          <div id="dsrFeedback" class="mt-3 p-3 rounded" style="font-size:13px; line-height: 1.5;"></div>
        </div>

        <div class="info-box info-yellow mt-3">
          <i class="bi bi-lightbulb"></i>
          <span>
            Suku bunga: <strong>2% per bulan (sliding rate/menurun)</strong>. 
            Premi / Biaya administrasi: <strong>1% fix</strong>.
            <%= isTopUp ? 'Sisa pinjaman lama akan otomatis ditutup saat pengajuan disetujui.' : 'Pengajuan akan ditinjau dan diverifikasi oleh admin koperasi.' %>
          </span>
        </div>

        <div class="action-row mt-4">
          <button type="submit" class="btn-primary" id="btnSubmit">
            <i class="bi bi-send"></i> <%= isTopUp ? 'Kirim Permohonan Top-Up' : 'Kirim Permohonan Pinjaman' %>
          </button>
          <a href="/simulasi" class="btn-secondary">
            <i class="bi bi-calculator"></i> Cek Simulasi Dulu
          </a>
        </div>
      </form>
    </div>
  </div>

  <script>
    const userGajiBersih = <%= gajiBersih || 6500000 %>;
    const isTopUp = <%= isTopUp ? 'true' : 'false' %>;
    const sisaPokokLama = <%= sisaPokokLama || 0 %>;

    function formatRp(v) {
      return new Intl.NumberFormat('id-ID', {style:'currency', currency:'IDR', minimumFractionDigits:0}).format(v);
    }

    function updatePreview() {
      const rawNom = document.getElementById('nominalInput').value.replace(/[^0-9]/g, '');
      const nominal = parseFloat(rawNom) || 0;
      const tenor   = parseInt(document.getElementById('tenorSelect').value) || 0;
      const box     = document.getElementById('previewBox');
      const dsrEl   = document.getElementById('dsrFeedback');
      const btnSubmit = document.getElementById('btnSubmit');

      // Update Breakdown Top-Up jika ada
      if (isTopUp) {
        const biayaAdmin = nominal * 0.01;
        const uangBersih = nominal - biayaAdmin - sisaPokokLama;
        const tuWarn = document.getElementById('topupWarning');

        document.getElementById('tuPlafon').textContent = formatRp(nominal);
        document.getElementById('tuAdmin').textContent = '( - ) ' + formatRp(biayaAdmin);
        document.getElementById('tuDiterima').textContent = formatRp(Math.max(0, uangBersih));

        if (nominal > 0 && nominal <= sisaPokokLama) {
          tuWarn.style.display = 'block';
          tuWarn.innerHTML = `<i class="bi bi-exclamation-octagon-fill"></i> Plafon baru (Rp ${nominal.toLocaleString('id-ID')}) belum mencukupi untuk melunasi sisa pokok lama (Rp ${Math.round(sisaPokokLama).toLocaleString('id-ID')}). Harap masukkan nominal lebih besar.`;
          btnSubmit.disabled = true;
        } else {
          tuWarn.style.display = 'none';
        }
      }

      if (!nominal || !tenor || nominal <= 0 || tenor <= 0) {
        box.style.display = 'none';
        return;
      }

      // Hitung cicilan bulan pertama (pokok + bunga 2%)
      const pokok = nominal / tenor;
      const bunga = 0.02 * nominal;
      const totalCicilan = pokok + bunga;
      const simpananWajib = 100000;
      const totalPotongan = totalCicilan + simpananWajib;
      const dsrPct = Math.round((totalPotongan / userGajiBersih) * 100);

      document.getElementById('prvPokok').textContent = formatRp(pokok);
      document.getElementById('prvBunga').textContent = formatRp(bunga);
      document.getElementById('prvTotal').textContent = formatRp(totalCicilan);

      // Evaluasi Kemampuan Bayar terhadap Gaji Bersih
      if (dsrPct <= 40) {
        dsrEl.style.background = 'rgba(16,185,129,0.12)';
        dsrEl.style.color = '#34d399';
        dsrEl.style.border = '1px solid rgba(16,185,129,0.3)';
        dsrEl.innerHTML = `
          <div class="d-flex align-center gap-2">
            <i class="bi bi-check-circle-fill" style="font-size: 20px;"></i>
            <div>
              <strong>Kemampuan Bayar AMAN (${dsrPct}% dari Gaji)</strong><br>
              <span style="font-size: 12px; color: #a7f3d0;">
                Estimasi potongan cicilan + simpanan wajib (Rp ${Math.round(totalPotongan).toLocaleString('id-ID')}) berada dalam batas ideal &lt; 40% gaji Anda (${formatRp(userGajiBersih)}). Pengajuan sangat berpeluang disetujui.
              </span>
            </div>
          </div>
        `;
        if (!isTopUp || nominal > sisaPokokLama) btnSubmit.disabled = false;
      } else if (dsrPct <= 50) {
        dsrEl.style.background = 'rgba(245,158,11,0.12)';
        dsrEl.style.color = '#fbbf24';
        dsrEl.style.border = '1px solid rgba(245,158,11,0.3)';
        dsrEl.innerHTML = `
          <div class="d-flex align-center gap-2">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 20px;"></i>
            <div>
              <strong>PERHATIAN: Rasio Cicilan ${dsrPct}% dari Gaji</strong><br>
              <span style="font-size: 12px; color: #fde68a;">
                Estimasi potongan bulanan (Rp ${Math.round(totalPotongan).toLocaleString('id-ID')}) mendekati batas maksimal kemampuan potong gaji (50%). Tetap dapat diajukan namun diimbau mempertimbangkan kebutuhan bulanan.
              </span>
            </div>
          </div>
        `;
        if (!isTopUp || nominal > sisaPokokLama) btnSubmit.disabled = false;
      } else {
        dsrEl.style.background = 'rgba(239,68,68,0.15)';
        dsrEl.style.color = '#fca5a5';
        dsrEl.style.border = '1px solid rgba(239,68,68,0.4)';
        dsrEl.innerHTML = `
          <div class="d-flex align-center gap-2">
            <i class="bi bi-x-octagon-fill" style="font-size: 24px; color: #f87171;"></i>
            <div>
              <strong style="color: #f87171; font-size: 14px;">PERINGATAN: GAJI TIDAK MENCUKUPI (Rasio ${dsrPct}% Gaji)</strong><br>
              <span style="font-size: 12px; color: #fecaca;">
                Estimasi potongan angsuran bulanan sebesar <strong>Rp ${Math.round(totalPotongan).toLocaleString('id-ID')}</strong> melebihi batas aman maksimal 50% dari gaji bersih Anda (<strong>${formatRp(userGajiBersih)}</strong>).
                <br>
                💡 <strong>Solusi:</strong> Silakan <strong>perpanjang tenor pinjaman</strong> (misal 24 atau 36 bulan) atau <strong>turunkan nominal pinjaman</strong> agar angsuran lebih ringan dan sesuai kapasitas gaji Anda.
              </span>
            </div>
          </div>
        `;
        btnSubmit.disabled = true;
      }

      box.style.display = 'block';
    }

    document.getElementById('nominalInput').addEventListener('input', updatePreview);
    document.getElementById('tenorSelect').addEventListener('change', updatePreview);

    if (document.getElementById('nominalInput').value && document.getElementById('tenorSelect').value) {
      updatePreview();
    }

    document.getElementById('formPengajuan').addEventListener('submit', function(e) {
      const btn = document.getElementById('btnSubmit');
      if (btn.disabled) {
        e.preventDefault();
        return;
      }
      btn.innerHTML = '<span class="spinner"></span> Mengirim...';
      btn.disabled = true;
    });
  </script>
<% } %>
